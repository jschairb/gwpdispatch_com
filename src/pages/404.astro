---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/base.astro";
import RuleDouble from "@/components/bases/rule-double.astro";

const entry = await getEntry("views", "error404");

if (!entry) {
  throw new Error("404 page not found");
}

const [HERO] = entry.data.blocks;
---

<BaseLayout entry={entry}>
  <div class="container py-24">
    <div class="mx-auto max-w-[640px] text-center">
      <span class="eyebrow">Error 404</span>
      <h1
        class="mt-3 font-serif text-4xl font-bold leading-tight tracking-[-0.02em] text-navy-deep sm:text-5xl dark:text-bone"
      >
        {HERO.title}
      </h1>
      <RuleDouble class="mt-6" />
      <p class="gwp-lead mt-6">{HERO.description}</p>
      <a
        href={HERO.link_url}
        class="btn-press btn-press-primary mt-8"
        aria-label="Return to Homepage">{HERO.link_text}</a
      >
    </div>
  </div>
</BaseLayout>
