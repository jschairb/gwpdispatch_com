---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/base.astro";

const entry = await getEntry("views", "error404");

if (!entry) {
  throw new Error("404 page not found");
}

const [HERO] = entry.data.blocks;
---

<BaseLayout entry={entry}>
  <div class="container flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-4xl font-bold text-navy dark:text-base-content">
      {HERO.title}
    </h1>
    <p class="mt-3 text-base-content/70">{HERO.description}</p>
    <a
      href={HERO.link_url}
      class="btn btn-primary mt-8 px-8"
      aria-label="Return to Homepage">{HERO.link_text}</a
    >
  </div>
</BaseLayout>
