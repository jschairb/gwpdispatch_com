---
import ListLayout from "@/layouts/list.astro";
import { getEntry } from "astro:content";
import { categoriesHandler } from "@/lib/handlers/categories";
import NewsCard from "@/components/cards/newsCard.astro";
import SectionHeader from "@/components/shared/section-header.astro";

const entry = await getEntry("views", "categories");

if (!entry) {
  return Astro.redirect("/404");
}

// Fetch all articles to extract categories
const categories = categoriesHandler.allCategoriesWithLatestArticles();
---

<ListLayout
  header={"Sections"}
  kicker="Index"
  description="Wire announcements, field reports from inside the build, and editorial dispatches."
  entry={entry}
>
  <ul class="w-full space-y-14">
    {
      categories.map((category) => {
        const { path, title, latestArticles } = category.data;
        const articleCount = category.data.count;
        return (
          <li class="flex flex-col gap-6">
            <SectionHeader
              kicker={`${articleCount} ${articleCount === 1 ? "article" : "articles"}`}
              title={title}
              linkTitle="See all"
              linkUrl={`/categories/${path}/1`}
            />
            {latestArticles.length > 0 ? (
              <div class="flex snap-x snap-proximity gap-6 overflow-x-auto pb-2">
                {latestArticles.slice(0, 6).map((article, index) => (
                  <div class="w-[300px] flex-none snap-start">
                    <NewsCard article={article} index={index} />
                  </div>
                ))}
              </div>
            ) : (
              <p class="font-serif text-base italic text-ink-500 dark:text-bone/55">
                Nothing filed in this section yet.
              </p>
            )}
          </li>
        );
      })
    }
  </ul>
</ListLayout>
