---
import { Image, Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate, normalizeDate } from "@/lib/utils/date";
import RuleDouble from "@/components/bases/rule-double.astro";
import Tag from "@/components/bases/tag.astro";
import Time04 from "@/assets/svgs/time-04.astro";
import { categoriesHandler } from "@/lib/handlers/categories";
import { authorsHandler } from "@/lib/handlers/authors";
import Share from "@/components/elements/share.astro";

type Props = {
  article: CollectionEntry<"articles">;
  readingTime: string;
};

const { article, readingTime } = Astro.props;

const category = categoriesHandler.oneCategory(article.data.category.id);
const authors = authorsHandler.getAuthors(article.data.authors);
const published = normalizeDate(article.data.publishedTime);
---

<section class="container pt-8">
  <div class="mx-auto max-w-[720px]">
    {/* Press header: section tag, dateline, double rule. */}
    <Tag
      id={category.id}
      title={category.data.title}
      href={`/categories/${category.data.path}/1`}
    />

    <h1
      class="mt-4 font-serif text-3xl font-bold leading-[1.08] tracking-[-0.012em] text-navy-deep text-pretty lg:text-[2.9rem] dark:text-bone"
    >
      {article.data.title}
    </h1>

    {
      article.data.description ? (
        <p class="gwp-lead mt-4">{article.data.description}</p>
      ) : null
    }

    {/* Byline row under the double rule. The AP dateline itself opens the
        body copy, press-release style, so it is not repeated here. */}
    <RuleDouble class="mt-6" />

    <div
      class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          authors.map((author) => (
            <a
              href={`/authors/${author.id}`}
              class="group flex items-center gap-2"
            >
              <Image
                src={author.data.avatar}
                alt=""
                width={48}
                height={48}
                loading={"eager"}
                format="webp"
                layout="constrained"
                quality={80}
                class="h-8 w-8 rounded-full object-cover grayscale transition-[filter] duration-200 group-hover:grayscale-0"
              />
              <span class="font-sans text-xs font-bold uppercase tracking-[0.08em] text-navy-deep transition-colors group-hover:text-gold-deep dark:text-bone dark:group-hover:text-gold-bright">
                {author.data.name}
              </span>
            </a>
          ))
        }
        <time
          datetime={published}
          class="font-sans text-xs uppercase tracking-[0.08em] text-ink-500 dark:text-bone/55"
        >
          {formatDate(published, "press")}
        </time>
        <span
          class="flex items-center gap-1.5 font-sans text-xs uppercase tracking-[0.08em] text-ink-500 dark:text-bone/55"
        >
          <Time04 size="14" />
          <span>{readingTime}</span>
        </span>
      </div>

      <Share text={article.data.title} />
    </div>

    <div
      class="mt-8 aspect-[20/9] overflow-hidden rounded-md border border-ink-100 dark:border-bone/12"
    >
      <Picture
        src={article.data.cover}
        alt={article.data.covert_alt
          ? article.data.covert_alt
          : article.data.title}
        layout="full-width"
        loading={"eager"}
        formats={["avif", "webp"]}
        class="h-full w-full object-cover object-center"
      />
    </div>
  </div>
</section>
