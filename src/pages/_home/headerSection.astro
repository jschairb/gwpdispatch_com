---
import SectionHeader from "@/components/shared/section-header.astro";

type Props = {
  title: string;
  link_title: string;
  link_url: string;
  kicker?: string;
};

const { title, link_title, link_url, kicker } = Astro.props;
---

<SectionHeader
  title={title}
  kicker={kicker}
  linkTitle={link_title}
  linkUrl={link_url}
/>
