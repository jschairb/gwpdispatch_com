---
import AuthorCard from "@/components/cards/authorCard.astro";
import SectionHeader from "@/components/shared/section-header.astro";
import { authorsHandler } from "@/lib/handlers/authors";

const authors = authorsHandler.limitAurhors(6);
---

<section class="container py-14" data-pagefind-ignore="all">
  <SectionHeader
    kicker="Masthead"
    title="Contributors"
    linkTitle="View all"
    linkUrl="/authors"
    class="mb-6"
  />
  <ul
    role="list"
    class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-6"
  >
    {authors.map((author) => <AuthorCard author={author} />)}
  </ul>
</section>
