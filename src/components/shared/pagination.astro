---
import ArrowLeftDouble from "@/assets/svgs/arrow-left-double.astro";
import ArrowRightDouble from "@/assets/svgs/arrow-right-double.astro";
import ArrowLeft01 from "@/assets/svgs/arrow-left-01.astro";
import ArrowRight01 from "@/assets/svgs/arrow-right-01.astro";

type Props = {
  length: number;
  currentUrl: string;
  currentPage: number;
  baseUrl: string;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  lastUrl: string;
};

const { length, currentUrl, currentPage, baseUrl, prevUrl, nextUrl, lastUrl } =
  Astro.props;

// Define the maximum number of visible buttons
const maxVisibleButtons = 4;

// Calculate the range of visible page numbers
const startPage = Math.max(1, currentPage - Math.floor(maxVisibleButtons / 2));
const endPage = Math.min(length, startPage + maxVisibleButtons - 1);

// Adjust the startPage if we're at the end of the pagination
const adjustedStartPage = Math.max(1, endPage - maxVisibleButtons + 1);

// Generate the pagination list based on the range
const paginationList = Array.from(
  { length: endPage - adjustedStartPage + 1 },
  (_, i) => adjustedStartPage + i
);

// Square-cornered press controls: 6px radius, hairline border, no pills.
const base =
  "inline-flex h-9 min-w-9 items-center justify-center gap-1 rounded-md px-3 font-sans text-xs font-bold uppercase tracking-[0.08em] transition-colors duration-200";
const rest = `${base} border border-ink-200 text-navy hover:border-navy hover:bg-bone dark:border-bone/25 dark:text-bone/80 dark:hover:border-gold-bright dark:hover:bg-navy-soft dark:hover:text-bone`;
const disabled = `${base} border border-ink-100 text-ink-300 pointer-events-none dark:border-bone/10 dark:text-bone/25`;
const active = `${base} border border-navy bg-navy text-white pointer-events-none dark:border-gold-bright dark:bg-gold-bright dark:text-navy-deep`;
---

<section
  class:list={[
    "mx-auto mt-12 flex items-center justify-center",
    !prevUrl && !nextUrl ? "hidden" : "",
  ]}
>
  <nav class="flex flex-wrap items-center justify-center gap-2">
    {
      `${baseUrl}/1` == `${currentUrl}` ? (
        <span class={disabled} aria-label="First page">
          <ArrowLeftDouble />
        </span>
      ) : (
        <a href={`${baseUrl}/1`} class={rest} aria-label="First page">
          <ArrowLeftDouble />
        </a>
      )
    }

    {
      prevUrl ? (
        <a href={prevUrl} class={rest}>
          <ArrowLeft01 /> <span class="hidden lg:block">Previous</span>
        </a>
      ) : (
        <span class={disabled}>
          <ArrowLeft01 /> <span class="hidden lg:block">Previous</span>
        </span>
      )
    }

    {
      paginationList.map((num) => (
        <a
          href={`${baseUrl}${num == 1 ? "" : "/" + num}`}
          class={currentPage == num ? active : rest}
        >
          {num}
        </a>
      ))
    }

    {
      !nextUrl ? (
        <span class={disabled}>
          <span class="hidden lg:block">Next</span> <ArrowRight01 />
        </span>
      ) : (
        <a href={nextUrl} class={rest}>
          <span class="hidden lg:block">Next</span> <ArrowRight01 />
        </a>
      )
    }

    {
      lastUrl == currentUrl ? (
        <span class={disabled} aria-label="Last page">
          <ArrowRightDouble />
        </span>
      ) : (
        <a href={lastUrl} class={rest} aria-label="Last page">
          <ArrowRightDouble />
        </a>
      )
    }
  </nav>
</section>
