---
import ArrowLeftDouble from "@/assets/svgs/arrow-left-double.astro";
import ArrowRightDouble from "@/assets/svgs/arrow-right-double.astro";
import ArrowLeft01 from "@/assets/svgs/arrow-left-01.astro";
import ArrowRight01 from "@/assets/svgs/arrow-right-01.astro";

type Props = {
  length: number;
  currentUrl: string;
  currentPage: number;
  baseUrl: string;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  lastUrl: string;
};

const { length, currentUrl, currentPage, baseUrl, prevUrl, nextUrl, lastUrl } =
  Astro.props;

// Define the maximum number of visible buttons
const maxVisibleButtons = 4;

// Calculate the range of visible page numbers
const startPage = Math.max(1, currentPage - Math.floor(maxVisibleButtons / 2));
const endPage = Math.min(length, startPage + maxVisibleButtons - 1);

// Adjust the startPage if we're at the end of the pagination
const adjustedStartPage = Math.max(1, endPage - maxVisibleButtons + 1);

// Generate the pagination list based on the range
const paginationList = Array.from(
  { length: endPage - adjustedStartPage + 1 },
  (_, i) => adjustedStartPage + i
);

// Pill buttons, matching the outline/navy pairing used on greatwesternproductions.com
const pill = "btn btn-sm btn-outline border-navy/25 text-navy hover:bg-navy hover:text-white hover:border-navy dark:border-white/25 dark:text-base-content dark:hover:bg-gold-light dark:hover:text-navy-dark dark:hover:border-gold-light";
const pillDisabled = "btn btn-sm btn-outline btn-disabled border-black/10 dark:border-white/10";
const pillActive = "btn btn-sm bg-navy text-white border-navy hover:bg-navy-dark hover:border-navy-dark pointer-events-none dark:bg-gold-light dark:text-navy-dark dark:border-gold-light";
---

<section
  class:list={[
    "flex items-center justify-center mx-auto mt-10",
    !prevUrl && !nextUrl ? "hidden" : "",
  ]}
>
  <nav class="flex flex-wrap items-center justify-center gap-2">
    {
      `${baseUrl}/1` == `${currentUrl}` ? (
        <span class={pillDisabled} aria-label="First page">
          <ArrowLeftDouble />
        </span>
      ) : (
        <a href={`${baseUrl}/1`} class={pill} aria-label="First page">
          <ArrowLeftDouble />
        </a>
      )
    }

    {
      prevUrl ? (
        <a href={prevUrl} class={pill}>
          <ArrowLeft01 /> <span class="hidden lg:block">Previous</span>
        </a>
      ) : (
        <span class={pillDisabled}>
          <ArrowLeft01 /> <span class="hidden lg:block">Previous</span>
        </span>
      )
    }

    {
      paginationList.map((num) => (
        <a
          href={`${baseUrl}${num == 1 ? "" : "/" + num}`}
          class={currentPage == num ? pillActive : pill}
        >
          {num}
        </a>
      ))
    }

    {
      !nextUrl ? (
        <span class={pillDisabled}>
          <span class="hidden lg:block">Next</span> <ArrowRight01 />
        </span>
      ) : (
        <a href={nextUrl} class={pill}>
          <span class="hidden lg:block">Next</span> <ArrowRight01 />
        </a>
      )
    }

    {
      lastUrl == currentUrl ? (
        <span class={pillDisabled} aria-label="Last page">
          <ArrowRightDouble />
        </span>
      ) : (
        <a href={lastUrl} class={pill} aria-label="Last page">
          <ArrowRightDouble />
        </a>
      )
    }
  </nav>
</section>
