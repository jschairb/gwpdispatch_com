---
import { NAVIGATION_LINKS, SOCIAL_LINKS, OTHER_LINKS } from "@/lib/config";
import Icon from "../bases/icon.astro";
import Logo from "../elements/logo.astro";

const year = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="container py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16">
      <!-- Column 1: Brand -->
      <div>
        <div class="mb-4">
          <Logo inverted />
        </div>
        <p class="text-sm text-white/60 leading-relaxed mb-2">
          The press hub for <a
            href="https://greatwesternproductions.com"
            class="text-white/80 hover:text-gold-light transition-colors"
            target="_blank">Great Western Productions</a
          >.
        </p>
        <p class="text-sm text-white/40">San Antonio, TX</p>
      </div>

      <!-- Column 2: Site links -->
      <div>
        <h2
          class="font-semibold text-sm uppercase tracking-wider text-white/40 mb-4"
        >
          Navigate
        </h2>
        <nav class="flex flex-col gap-2">
          <a
            href="/"
            class="text-sm text-white/70 hover:text-white transition-colors"
            >Home</a
          >
          <a
            href="/articles"
            class="text-sm text-white/70 hover:text-white transition-colors"
            >Articles</a
          >
          {
            NAVIGATION_LINKS.map(({ href, text, target }) => (
              <a
                href={href}
                target={target ?? "_self"}
                class="text-sm text-white/70 hover:text-white transition-colors"
              >
                {text}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Column 3: Connect -->
      <div>
        <h2
          class="font-semibold text-sm uppercase tracking-wider text-white/40 mb-4"
        >
          Connect
        </h2>
        <div class="flex flex-col gap-3">
          {
            SOCIAL_LINKS.map(({ href, icon, text, target }) => (
              <a
                href={href}
                target={target ?? "_blank"}
                title={text}
                aria-label={text}
                class="text-sm text-white/70 hover:text-white transition-colors inline-flex items-center gap-1.5 w-fit"
              >
                <Icon icon={icon} />
                {text}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="border-t border-white/10 mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <nav class="flex flex-wrap items-center gap-3 text-sm text-white/50">
        {
          OTHER_LINKS.map(({ href, text, target }) => (
            <a
              href={href}
              target={target ?? "_self"}
              class="hover:text-white/80 transition-colors"
            >
              {text}
            </a>
          ))
        }
      </nav>
      <p class="text-sm text-white/40">
        © {year} Great Western Productions, LLC. All rights reserved.
      </p>
    </div>
  </div>
</footer>
