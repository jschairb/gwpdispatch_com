---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
type Props = {
  author: CollectionEntry<"authors">;
};

const { author } = Astro.props;
---

{/* Press portrait: black and white at rest, color on hover. */}
<li class="group relative isolate mx-auto w-full">
  <Image
    class="aspect-square w-full max-w-full rounded-md border border-ink-100 object-cover grayscale transition-[filter] duration-200 group-hover:grayscale-0 dark:border-bone/12"
    src={author.data.avatar}
    alt={author.data.name}
    layout="constrained"
    loading={"lazy"}
    width={320}
    height={320}
  />
  <div class="mt-3 flex flex-col gap-1">
    <h3 class="font-serif text-base font-bold leading-snug">
      <a href={`/authors/${author.id}`} class="headline-link">
        <span class="absolute inset-0 z-10 pointer-events-none"></span>
        {author.data.name}
      </a>
    </h3>
    <p
      class="font-sans text-xs uppercase tracking-[0.08em] text-ink-500 dark:text-bone/55"
    >
      {author.data.job}
    </p>
  </div>
</li>
