---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Tag from "@/components/bases/tag.astro";
import { categoriesHandler } from "@/lib/handlers/categories";

type Props = {
  article: CollectionEntry<"articles">;
  index: number;
};

const { article, index } = Astro.props;

const { remarkPluginFrontmatter } = await render(article);
const category = categoriesHandler.oneCategory(article.data.category.id);
---

{/* Paper card: cover flush to the top, hairline border, padded body. */}
<article
  class="press-card group relative isolate col-span-1 mx-auto flex h-full w-full max-w-sm flex-col overflow-hidden"
>
  <div class="aspect-video overflow-hidden bg-bone dark:bg-navy-soft">
    <Image
      src={article.data.cover}
      alt={article.data.covert_alt
        ? article.data.covert_alt
        : article.data.title}
      loading={index < 3 ? "eager" : "lazy"}
      layout="constrained"
      class="h-full w-full object-cover transition-transform duration-300 ease-out lg:group-hover:scale-[1.04]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <Tag id={category.id} title={category.data.title} class="w-fit" />

    <h3 class="font-serif text-[1.2rem] font-bold leading-[1.2] line-clamp-2">
      <a href={`/articles/${article.id}`} class="headline-link">
        <span class="absolute inset-0 z-10 pointer-events-none"></span>
        {article.data.title}
      </a>
    </h3>

    <p
      class="font-sans text-sm leading-relaxed text-pretty text-ink-500 line-clamp-3 lg:mb-auto dark:text-bone/60"
    >
      {article.data.description}
    </p>

    <div
      class="flex items-center gap-2 pt-1 font-sans text-xs tracking-[0.04em] text-ink-500 dark:text-bone/55"
    >
      <span>{remarkPluginFrontmatter.minutesRead}</span>
    </div>
  </div>
</article>
