---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate, getDateDistance, normalizeDate } from "@/lib/utils/date";
import Tag from "@/components/bases/tag.astro";
import { categoriesHandler } from "@/lib/handlers/categories";

type Props = {
  article: CollectionEntry<"articles">;
  isLast: boolean;
};

const { article, isLast } = Astro.props;
const published = normalizeDate(article.data.publishedTime);
const category = categoriesHandler.oneCategory(article.data.category.id);
---

{/* Wire-log row: date rail, headline block, cover. */}
<li
  class:list={[
    "group relative isolate mx-auto flex w-full max-w-md flex-col gap-4 pb-6 lg:max-w-full lg:flex-row lg:gap-8",
    isLast ? "border-b-0" : "border-b border-ink-100 dark:border-bone/12",
  ]}
>
  <div
    class="hidden w-36 shrink-0 flex-col gap-1 pt-1 lg:flex"
    aria-hidden="true"
  >
    <time
      datetime={published}
      class="font-sans text-xs font-bold uppercase tracking-[0.1em] text-navy-deep dark:text-bone/80"
    >
      {formatDate(published, "press")}
    </time>
    <span class="font-sans text-xs text-ink-300 dark:text-bone/45">
      {getDateDistance(published)}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-4 lg:flex-row-reverse lg:items-start">
    <div
      class="aspect-video w-full shrink-0 overflow-hidden rounded-md border border-ink-100 lg:w-60 dark:border-bone/12"
    >
      <Image
        src={article.data.cover}
        alt={article.data.covert_alt
          ? article.data.covert_alt
          : article.data.title}
        layout="constrained"
        loading={"eager"}
        class="aspect-video h-full w-full object-cover transition-transform duration-300 ease-out lg:group-hover:scale-[1.04]"
      />
    </div>

    <div class="flex flex-1 flex-col gap-2">
      <Tag id={category.id} title={category.data.title} class="w-fit" />
      <h3 class="font-serif text-xl font-bold leading-[1.2] lg:text-2xl">
        <a href={`/articles/${article.id}`} class="headline-link">
          <span class="absolute inset-0 z-10"></span>
          {article.data.title}
        </a>
      </h3>
      <p
        class="max-w-2xl font-sans text-[0.95rem] leading-relaxed text-pretty text-ink-500 dark:text-bone/60"
      >
        {article.data.description}
      </p>
      <time
        datetime={published}
        class="pt-1 font-sans text-xs uppercase tracking-[0.08em] text-ink-500 lg:hidden dark:text-bone/55"
      >
        {formatDate(published, "press")}
      </time>
    </div>
  </div>
</li>
