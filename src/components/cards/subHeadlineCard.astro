---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Tag from "@/components/bases/tag.astro";
import { getDateDistance } from "@/lib/utils/date";
import { categoriesHandler } from "@/lib/handlers/categories";

type Props = {
  article: CollectionEntry<"articles">;
  isFirst?: boolean;
  isLast?: boolean;
};
const { article, isLast, isFirst } = Astro.props;

const { remarkPluginFrontmatter } = await render(article);
const category = categoriesHandler.oneCategory(article.data.category.id);
---

<article
  class:list={[
    "group relative isolate flex items-stretch gap-4",
    isFirst ? "pt-0" : "pt-4",
    isLast
      ? "border-b-0 pb-0"
      : "border-b border-ink-100 pb-4 dark:border-bone/12",
  ]}
>
  <div class="flex flex-1 flex-col gap-1.5">
    <Tag id={category.id} title={category.data.title} class="w-fit" />

    <h3 class="font-serif text-[1.15rem] font-bold leading-[1.2]">
      <a href={`/articles/${article.id}`} class="headline-link">
        <span class="absolute inset-0 z-10 pointer-events-none"></span>
        {article.data.title}
      </a>
    </h3>

    <p
      class="font-sans text-sm leading-relaxed text-ink-500 md:line-clamp-2 lg:line-clamp-3 dark:text-bone/60"
    >
      {article.data.description}
    </p>

    <div
      class="mt-auto flex items-center gap-2 pt-1 font-sans text-xs tracking-[0.04em] text-ink-500 dark:text-bone/55"
    >
      <span>{getDateDistance(remarkPluginFrontmatter.lastModified)}</span>
      <span class="text-gold" aria-hidden="true">&bull;</span>
      <span>{remarkPluginFrontmatter.minutesRead}</span>
    </div>
  </div>

  <div
    class="h-[110px] w-[130px] shrink-0 overflow-hidden rounded-md border border-ink-100 sm:h-full md:w-[120px] dark:border-bone/12"
  >
    <Image
      src={article.data.cover}
      alt={article.data.covert_alt
        ? article.data.covert_alt
        : article.data.title}
      loading="eager"
      widths={[120, 320]}
      layout="constrained"
      class="h-full w-full object-cover transition-transform duration-300 ease-out lg:group-hover:scale-[1.04]"
    />
  </div>
</article>
