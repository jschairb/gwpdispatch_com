---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Divider from "@/components/bases/divider.astro";
import { categoriesHandler } from "@/lib/handlers/categories";
import { getDateDistance } from "@/lib/utils/date";

type Props = {
  article: CollectionEntry<"articles">;
};

const { article } = Astro.props;

const { remarkPluginFrontmatter } = await render(article);

const category = categoriesHandler.oneCategory(article.data.category.id);
---

<article class="group relative isolate flex flex-col-reverse md:flex-col gap-4">
  <div class="aspect-video overflow-hidden rounded-xl">
    <Image
      src={article.data.cover}
      alt={article.data.covert_alt
        ? article.data.covert_alt
        : article.data.title}
      layout="constrained"
      loading={"eager"}
      class="w-full h-full object-cover transition-transform duration-300 lg:group-hover:scale-105"
    />
  </div>
  <div class="flex flex-col gap-2">
    <div>
      <span class="eyebrow">{category.data.title}</span>
      <h2 class="text-2xl lg:text-3xl font-semibold leading-tight mt-1.5">
        <a href={`/articles/${article.id}`} class="headline-link">
          <span class="absolute inset-0 z-10 pointer-events-none"></span>
          {article.data.title}
        </a>
      </h2>
      <p class="text-base-content/70 text-base max-w-lg mt-2 leading-relaxed">
        {article.data.description}
      </p>
    </div>
    <div class="flex items-center text-xs text-base-content/60 mt-2">
      <span>{getDateDistance(remarkPluginFrontmatter.lastModified)}</span>
      <Divider />
      <span>{remarkPluginFrontmatter.minutesRead}</span>
    </div>
  </div>
</article>
