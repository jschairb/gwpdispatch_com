---
import Clipboard from "@/assets/svgs/clipboard.astro";
import Facebook from "@/assets/svgs/facebook.astro";
import Linkedin from "@/assets/svgs/linkedin.astro";
import Twitter from "@/assets/svgs/twitter.astro";
import Whatsapp from "@/assets/svgs/whatsapp.astro";

type Props = {
  title: string;
  dataAwSocialShare: string;
  dataAwUrl: string | URL;
  dataAwText: string;
  icon: "clipboard" | "facebook" | "linkedin" | "twitter" | "whatsapp";
};

const { title, dataAwSocialShare, dataAwUrl, dataAwText, icon } = Astro.props;

const iconMap = {
  clipboard: Clipboard,
  facebook: Facebook,
  linkedin: Linkedin,
  twitter: Twitter,
  whatsapp: Whatsapp,
} as const;

const Icon = iconMap[icon];
---

{/* Secondary press button: border holds, ground fills to bone, 1px press. */}
<button
  class="grid h-9 w-9 cursor-pointer place-items-center rounded-md border border-ink-200 text-ink-500 transition-colors duration-200 hover:border-navy hover:bg-bone hover:text-navy active:translate-y-px dark:border-bone/25 dark:text-bone/65 dark:hover:border-gold-bright dark:hover:bg-navy-soft dark:hover:text-bone"
  title={title}
  aria-label={title}
  data-aw-social-share={dataAwSocialShare}
  data-aw-url={dataAwUrl}
  data-aw-text={dataAwText}
  type="button"
>
  <span aria-hidden="true">
    <Icon />
  </span>
</button>
