---
import type { Link } from "@/lib/types";

type Props = {
  item: Link;
};
const currentPath = Astro.url.pathname;
const { item } = Astro.props;

function isActive(item: Link, currentPath: string) {
  const segment = currentPath.split("/")[2];
  return (
    (item.text === "Home" && currentPath === "/") ||
    (item.text === "Articles" &&
      segment !== undefined &&
      !Number.isNaN(Number(segment)) &&
      Number(segment) >= 1) ||
    (item.text !== "Articles" &&
      currentPath.split("/").includes(item.text.toLocaleLowerCase()))
  );
}

function formatHref(href: string) {
  return href === "/" ? "/" : `${href}/1`;
}

const active = isActive(item, currentPath);
---

<li
  class:list={[
    "relative after:absolute after:-bottom-2 after:left-0 after:h-[2px] after:w-full after:transition-all after:duration-300",
    active ? "after:bg-gold pointer-events-none" : "after:bg-transparent",
  ]}
>
  <a
    href={formatHref(item.href)}
    aria-label={item.text}
    class:list={[
      "text-base whitespace-nowrap transition-colors",
      active
        ? "text-navy font-medium dark:text-base-content"
        : "text-base-content/70 hover:text-base-content",
    ]}>{item.text}</a
  >
</li>
