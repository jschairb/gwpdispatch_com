---
import type { Link } from "@/lib/types";

type Props = {
  item: Link;
};
const currentPath = Astro.url.pathname;
const { item } = Astro.props;

function isActive(item: Link, currentPath: string) {
  const segment = currentPath.split("/")[2];
  return (
    (item.text === "Home" && currentPath === "/") ||
    (item.text === "Articles" &&
      segment !== undefined &&
      !Number.isNaN(Number(segment)) &&
      Number(segment) >= 1) ||
    (item.text !== "Articles" &&
      currentPath.split("/").includes(item.text.toLocaleLowerCase()))
  );
}

function formatHref(href: string) {
  return href === "/" ? "/" : `${href}/1`;
}

const active = isActive(item, currentPath);
---

<li
  class:list={[
    "relative after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-full after:transition-colors after:duration-200",
    active ? "after:bg-gold pointer-events-none" : "after:bg-transparent",
  ]}
>
  <a
    href={formatHref(item.href)}
    aria-label={item.text}
    class:list={[
      "whitespace-nowrap font-sans text-[13px] font-bold uppercase tracking-[0.1em] transition-colors duration-200",
      active
        ? "text-gold-deep dark:text-gold-bright"
        : "text-navy-deep hover:text-navy-soft dark:text-bone/75 dark:hover:text-bone",
    ]}>{item.text}</a
  >
</li>
