---
import Moon from "@/assets/svgs/moon.astro";
import Sun from "@/assets/svgs/sun.astro";
---

<label
  class="swap swap-rotate grid h-9 w-9 cursor-pointer place-items-center rounded-sm border border-transparent text-ink-700 transition-colors duration-200 hover:border-ink-200 hover:bg-bone hover:text-navy dark:text-bone/80 dark:hover:border-bone/25 dark:hover:bg-navy-soft dark:hover:text-bone"
  for="theme-controller"
>
  <input
    type="checkbox"
    class="theme-controller"
    value="dark"
    name="theme-controller"
    id="theme-controller"
  />

  <Sun />
  <Moon />

  <span class="sr-only">Toggle theme</span>
</label>

<script is:inline>
  // Function to apply the initial theme and set the checkbox state
  function applyTheme() {
    const theme = localStorage.getItem("astro-theme") || "light"; // Default to light theme
    const themeController = document.querySelector(".theme-controller");

    // Update the checkbox state and apply the theme
    if (theme === "dark") {
      if (themeController) themeController.checked = true;
      document.documentElement.setAttribute("data-theme", "dark");
    } else {
      if (themeController) themeController.checked = false;
      document.documentElement.setAttribute("data-theme", "light");
    }
  }

  // Add event listener to toggle theme when the checkbox is clicked
  function handleThemeToggle(event) {
    const isDark = event.target.checked;
    const newTheme = isDark ? "dark" : "light";
    localStorage.setItem("astro-theme", newTheme);
    document.documentElement.setAttribute("data-theme", newTheme);
  }

  document.addEventListener("astro:page-load", () => {
    applyTheme();
    const themeController = document.querySelector(".theme-controller");
    themeController.addEventListener("change", handleThemeToggle);
  });

  // Apply theme immediately on script execution
  applyTheme();
</script>
