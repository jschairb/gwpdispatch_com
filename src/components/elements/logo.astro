---
/**
 * The Dispatch lockup: the GWP mark (mountain + compass star) beside the
 * Norwester "GREAT WESTERN" over Josefin Sans deco caps "DISPATCH".
 * The mark-only file is correct here — the square lockups already carry the
 * name and would set it twice.
 */
type Props = {
  /** Renders the lockup for deep-navy grounds such as the footer. */
  inverted?: boolean;
  class?: string;
};

const { inverted = false, class: className } = Astro.props;
---

<a
  href="/"
  class:list={["flex items-center gap-2.5 shrink-0", className]}
  aria-label="GWP Dispatch home"
>
  {
    /* The mark is navy on transparent. On deep navy it is flattened to a
       single-color white until a true one-color file exists. */
  }
  <img
    src="/assets/gwp-mark.png"
    alt=""
    width="48"
    height="35"
    class:list={[
      "h-[34px] w-[47px] shrink-0 object-contain",
      inverted ? "brightness-0 invert" : "dark:brightness-0 dark:invert",
    ]}
    loading="eager"
  />
  <span
    class:list={[
      "flex flex-col",
      inverted ? "text-bone" : "text-navy-deep dark:text-bone",
    ]}
  >
    <span class="wordmark-primary">Great Western</span>
    <span class="wordmark-secondary">Dispatch</span>
  </span>
</a>
